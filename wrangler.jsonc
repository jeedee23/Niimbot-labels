{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niimbot-labels",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "assets": {
    "directory": "./html",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  }
}
